# API Environment Configuration

# Data Providers
# Twelve Data API Key (Get free key at https://twelvedata.com if desired)
TWELVE_DATA_API_KEY=
# Data Provider: 'spot' (real-time live spot), 'twelvedata', 'yfinance', or 'mock'
DEFAULT_DATA_PROVIDER=spot

# Telegram Bot Setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Explanation Layer (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./tradegod.db

# Trading Configuration
DEFAULT_SYMBOL=XAU/USD
DEFAULT_RISK_PERCENT=1.0
MAX_DAILY_LOSS_PERCENT=2.0
MAX_TRADES_PER_DAY=5

# SMTP Email Configuration (Optional - for live password reset email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tradegod.ai
SMTP_USE_TLS=true
APP_URL=https://tradegod.onrender.com
